rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile: signed-in users can find each other by name.
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 20;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'nameLower'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && request.resource.data.nameLower is string
        && request.resource.data.nameLower.size() <= 100;
    }

    // Email lookup: exact address only, no listing.
    match /emails/{email} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // One document per pair of users.
    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'requestedBy', 'status', 'names', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.names[request.auth.uid]
           == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
      // Only the person who received the request can accept it.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'ACCEPTED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Messages wait here until the receiver's phone has saved them.
    match /inbox/{userId}/messages/{messageId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid != userId
        && request.resource.data.keys().hasOnly(['senderId', 'pairId', 'text', 'sentAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.sentAt is int
        && isFriendPair(request.resource.data.pairId, request.auth.uid, userId);
    }

    function isFriendPair(pairId, sender, receiver) {
      let pair = get(/databases/$(database)/documents/friendships/$(pairId)).data;
      return pair.status == 'ACCEPTED' && sender in pair.members && receiver in pair.members;
    }

    // Everything else stays closed.
  }
}
